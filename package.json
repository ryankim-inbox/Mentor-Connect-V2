{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run build:release",
    "build:release": "pnpm run typecheck && pnpm --filter @workspace/api-gateway build && pnpm --filter @workspace/peerbridge build",
    "build:all": "pnpm -r --if-present build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:gateway": "pnpm --filter @workspace/api-gateway run test && pnpm --filter @workspace/api-gateway run test:shield",
    "gateway:verify-boundary": "node scripts/verify-api-boundary.mjs",
    "test:peerbridge-release": "pnpm --filter @workspace/peerbridge run release:verify",
    "test:migrations": "sh scripts/test-migration-entrypoint.sh && sh scripts/test-post-merge.sh",
    "secrets:scan": "sh scripts/check-secrets.sh",
    "secrets:scan:self-test": "sh scripts/check-secrets.sh --self-test",
    "secrets:history": "sh scripts/check-secret-history.sh",
    "test:secret-workflow-policy": "sh scripts/test-secret-workflow-policy.sh",
    "test:secrets": "sh scripts/test-secret-history.sh && sh scripts/test-secret-workflow-policy.sh",
    "api:generate": "pnpm --filter @workspace/api-spec codegen",
    "api:contract-test": "node scripts/test-api-contract.mjs",
    "e2e": "playwright test"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "@playwright/test": "1.63.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.2",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.2",
    "lightningcss-darwin-arm64": "1.31.1"
  }
}
