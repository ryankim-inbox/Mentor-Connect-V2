# Copy this file to Python/.env and adjust for your machine:
#   cp Python/.env.example Python/.env
DATABASE_URL=postgresql://USER@localhost:5432/test_db
SESSION_SECRET=dev-secret-change-me
PORT=8000
# Mail remains disabled until a separately approved test setup.
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_ALLOWLIST_ENABLED=false
# Member access is separate from signup eligibility and actual email ownership.
TEST_MEMBER_ACCESS_ENABLED=false
# Set both exact account IDs privately only after identifying the two test users.
# TEST_MEMBER_MENTOR_ID=
# TEST_MEMBER_MENTEE_ID=
# Both APP_ORIGIN and GATEWAY_PUBLIC_ORIGIN must exactly equal
# https://mentor-connect-test.onrender.com. See docs/TEST_MEMBER_ACCESS.md.
# Keep the actual EMAIL_TEST_RECIPIENT and RESEND_API_KEY out of source.
# Resend testing also requires identical trusted HTTPS APP_ORIGIN and
# GATEWAY_PUBLIC_ORIGIN values. See docs/MAIL_PROVIDER_OPTIONS.md.
