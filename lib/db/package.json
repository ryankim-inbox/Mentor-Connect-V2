{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "schema:check": "node tools/schema-cli.mjs schema:check",
    "migration:status": "node tools/schema-cli.mjs migration:status",
    "schema:diff": "node tools/schema-cli.mjs schema:diff",
    "migration:preflight": "node tools/schema-cli.mjs migration:preflight",
    "migration:apply": "node tools/schema-cli.mjs migration:apply",
    "constraints:verify": "node tools/schema-cli.mjs constraints:verify",
    "explain:verify": "node tools/schema-cli.mjs explain:verify",
    "test": "node --test test/schema-tool.test.mjs test/schema-version.test.mjs test/sql-safety.test.mjs test/integrity-tool.test.mjs && tsx --test test/drizzle-schema.test.ts && sh test/disposable-postgres.sh"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
